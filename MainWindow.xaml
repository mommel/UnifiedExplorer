<Window x:Class="UnifiedExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="root"
        Title="Unified Explorer" Height="700" Width="1200" Loaded="Window_Loaded">
    
    <Window.Resources>
        <FontFamily x:Key="FluentIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>
        
        <!-- Row 0: Command Bar -->
        <ToolBarTray Grid.Row="0" Background="Transparent" IsLocked="True">
            <ToolBar Background="Transparent" Band="1" BandIndex="1" Margin="0,5">
                <Button Style="{StaticResource IconButton}" Content="&#xECC8;" ToolTip="New" Click="MenuNewFolder_Click"/>
                <Separator/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Cut" Click="MenuCut_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Click="MenuCopy_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="Paste" Click="MenuPaste_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename" Click="MenuRename_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Click="MenuDelete_Click"/>
                <Separator/>
                <Button Style="{StaticResource IconButton}" Content="&#xEA37;" ToolTip="Toggle Preview" Click="TogglePreview_Click" HorizontalAlignment="Right"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Row 1: Nav Bar -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE197;" ToolTip="Up" Click="Up_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="Refresh_Click"/>
            </StackPanel>

            <TextBox x:Name="PathTextBox" Grid.Column="1" Margin="10,0" VerticalContentAlignment="Center" KeyDown="PathTextBox_KeyDown"/>
            <TextBox x:Name="SearchTextBox" Grid.Column="2" Margin="0,0,5,0" VerticalContentAlignment="Center" Text="Search..." Foreground="Gray" GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus"/>
        </Grid>

        <!-- Row 2: Main Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0" x:Name="PreviewColumn"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ListBox x:Name="FavoritesList" BorderThickness="0" Background="Transparent" FontSize="14" AllowDrop="True" Drop="FavoritesList_Drop" SelectionChanged="FavoritesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="5,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource FluentIcons}" Text="{Binding Icon}" Margin="0,0,10,0" Foreground="{Binding IconColor}" VerticalAlignment="Center" FontSize="16"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE840;" FontSize="12" Foreground="#808080" ToolTip="Unpin" Click="Unpin_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Separator Margin="10,5"/>
                    <TreeView x:Name="ThisPCTree" BorderThickness="0" Background="Transparent" FontSize="14" SelectedItemChanged="ThisPCTree_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding Icon}" Margin="0,0,10,0" Foreground="{Binding IconColor}" VerticalAlignment="Center" FontSize="16"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- File List -->
            <ListView x:Name="FileListView" Grid.Column="2" BorderThickness="0" MouseDoubleClick="FileListView_MouseDoubleClick" SelectionChanged="FileListView_SelectionChanged" GridViewColumnHeader.Click="GridViewColumnHeader_Click" PreviewMouseMove="FileListView_PreviewMouseMove" PreviewMouseWheel="FileListView_PreviewMouseWheel" IsTextSearchEnabled="False" PreviewTextInput="FileListView_PreviewTextInput">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="MenuOpen_Click"/>
                        <MenuItem Header="Copy" Click="MenuCopy_Click"/>
                        <MenuItem Header="Paste" Click="MenuPaste_Click"/>
                        <MenuItem Header="Rename" Click="MenuRename_Click"/>
                        <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                        <Separator/>
                        <MenuItem Header="New Folder" Click="MenuNewFolder_Click"/>
                        <MenuItem Header="New File" Click="MenuNewFile_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <!-- Default GridView mode setup in CodeBehind to handle references easier -->
            </ListView>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" x:Name="PreviewSplitter" Visibility="Collapsed"/>

            <!-- Preview Panel -->
            <Border Grid.Column="4" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="1,0,0,0" x:Name="PreviewPanelBorder" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Grid Margin="0,20">
                            <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding ElementName=FileListView, Path=SelectedItem.Icon}" Foreground="{Binding ElementName=FileListView, Path=SelectedItem.IconColor}" FontSize="64" HorizontalAlignment="Center" Visibility="{Binding ElementName=FileListView, Path=SelectedItem.IconVisibility, FallbackValue=Visible}" />
                            <Image Source="{Binding ElementName=FileListView, Path=SelectedItem.Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" Visibility="{Binding ElementName=FileListView, Path=SelectedItem.ThumbnailVisibility, FallbackValue=Collapsed}"/>
                        </Grid>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Item type:" FontWeight="Bold" Margin="0,5,0,0" x:Name="PreviewTypeLbl"/>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.Type}"/>
                        <TextBlock Text="Size:" FontWeight="Bold" Margin="0,10,0,0" x:Name="PreviewSizeLbl"/>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.Size}"/>
                        <TextBlock Text="Date modified:" FontWeight="Bold" Margin="0,10,0,0" x:Name="PreviewDateLbl"/>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.DateModified}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F3F3F3" Padding="5,0">
            <StatusBarItem x:Name="ItemCountLbl" Content="0 items"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE14C;" ToolTip="Details View" Click="ViewDetails_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE154;" ToolTip="Large Icons View" Click="ViewLargeIcons_Click"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
