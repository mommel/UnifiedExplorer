<Window x:Class="UnifiedExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="root"
        Title="Unified Explorer" Height="700" Width="1200" Loaded="Window_Loaded"
        Icon="pack://application:,,,/assets/app.ico"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource TextColor}">
    
    <Window.Resources>
        <FontFamily x:Key="FluentIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>
        
        <!-- Row 0: Command Bar -->
        <Border Grid.Row="0" Background="{DynamicResource MenuBarColor}">
            <Grid Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xECC8;" ToolTip="New" Click="MenuNewFolder_Click" Foreground="{DynamicResource TextColor}"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Cut" Click="MenuCut_Click" Foreground="{DynamicResource TextColor}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Click="MenuCopy_Click" Foreground="{DynamicResource TextColor}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="Paste" Click="MenuPaste_Click" Foreground="{DynamicResource TextColor}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename" Click="MenuRename_Click" Foreground="{DynamicResource TextColor}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Click="MenuDelete_Click" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xEA37;" ToolTip="Toggle Preview" Click="TogglePreview_Click" Foreground="{DynamicResource TextColor}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Options" Click="MenuOptions_Click" Foreground="{DynamicResource TextColor}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Options/Einstellungen" Click="SettingsMenuItem_Click"/>
                                <MenuItem Header="Version" IsEnabled="False" x:Name="VersionMenuItem">
                                    <MenuItem.Icon>
                                        <Image Source="pack://application:,,,/assets/app.ico" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Nav Bar -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" Foreground="{DynamicResource TextColor}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward" Foreground="{DynamicResource TextColor}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE197;" ToolTip="Up" Click="Up_Click" Foreground="{DynamicResource TextColor}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="Refresh_Click" Foreground="{DynamicResource TextColor}"/>
            </StackPanel>

            <TextBox x:Name="PathTextBox" Grid.Column="1" Margin="10,0" Padding="21,10,0,10" VerticalContentAlignment="Center" KeyDown="PathTextBox_KeyDown" Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource TextColor}"/>
            <TextBox x:Name="SearchTextBox" Grid.Column="2" Margin="0,0,5,0" VerticalContentAlignment="Center" Text="Search..." Foreground="{DynamicResource TextColor}" Background="{DynamicResource BackgroundColor}" GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus"/>
        </Grid>

        <!-- Row 2: Main Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0" x:Name="PreviewColumn"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ListBox x:Name="FavoritesList" BorderThickness="0" Background="Transparent" FontSize="14" AllowDrop="True" Drop="FavoritesList_Drop" SelectionChanged="FavoritesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="5,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectColor}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding Icon}" Margin="24,8,10,8" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextColor}"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="📌" FontFamily="Segoe UI Emoji" FontSize="12" Foreground="#808080" ToolTip="Unpin" Click="Unpin_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Separator Margin="10,21"/>
                    <TreeView x:Name="ThisPCTree" BorderThickness="0" Background="Transparent" FontSize="14" Margin="21,0,0,0" SelectedItemChanged="ThisPCTree_SelectedItemChanged" TreeViewItem.Expanded="TreeViewItem_Expanded">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                            <Style TargetType="ToggleButton">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectColor}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="{Binding ContentMargin}">
                                    <Image Source="{Binding Icon}" Margin="20,0,10,0" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Column="1" Width="2" Fill="{DynamicResource FolderStringColor}" HorizontalAlignment="Center" IsHitTestVisible="False"/>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- File List -->
            <Grid Grid.Column="2">
                <ListView x:Name="FileListView" BorderThickness="0" Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource TextColor}" MouseDoubleClick="FileListView_MouseDoubleClick" SelectionChanged="FileListView_SelectionChanged" GridViewColumnHeader.Click="GridViewColumnHeader_Click" PreviewMouseMove="FileListView_PreviewMouseMove" PreviewMouseWheel="FileListView_PreviewMouseWheel" IsTextSearchEnabled="False" PreviewTextInput="FileListView_PreviewTextInput" PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="FileListView_PreviewMouseLeftButtonUp">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=View}" Value="{x:Null}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectColor}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="MenuOpen_Click"/>
                        <MenuItem Header="Copy" Click="MenuCopy_Click"/>
                        <MenuItem Header="Paste" Click="MenuPaste_Click"/>
                        <MenuItem Header="Rename" Click="MenuRename_Click"/>
                        <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                        <Separator/>
                        <MenuItem Header="New Folder" Click="MenuNewFolder_Click"/>
                        <MenuItem Header="New File" Click="MenuNewFile_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>


                    <!-- Default GridView mode setup in CodeBehind to handle references easier -->
                </ListView>
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionRectangle" Fill="#330078D7" Stroke="#0078D7" StrokeThickness="1" Visibility="Collapsed" />
                </Canvas>
            </Grid>

            <Rectangle Grid.Column="3" Width="2" Fill="{DynamicResource FolderStringColor}" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=PreviewSplitter}"/>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" x:Name="PreviewSplitter" Visibility="Collapsed"/>

            <!-- Preview Panel -->
            <Border Grid.Column="4" Background="{DynamicResource BackgroundColor}" BorderBrush="{DynamicResource MenuBarColor}" BorderThickness="1,0,0,0" x:Name="PreviewPanelBorder" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Grid Margin="0,20">
                            <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding ElementName=FileListView, Path=SelectedItem.Icon}" Foreground="{Binding ElementName=FileListView, Path=SelectedItem.IconColor}" FontSize="64" HorizontalAlignment="Center" Visibility="{Binding ElementName=FileListView, Path=SelectedItem.IconVisibility, FallbackValue=Visible}" />
                            <Image Source="{Binding ElementName=FileListView, Path=SelectedItem.Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" Visibility="{Binding ElementName=FileListView, Path=SelectedItem.ThumbnailVisibility, FallbackValue=Collapsed}"/>
                        </Grid>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Item type:" FontWeight="Bold" Margin="0,5,0,0" x:Name="PreviewTypeLbl"/>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.Type}"/>
                        <TextBlock Text="Size:" FontWeight="Bold" Margin="0,10,0,0" x:Name="PreviewSizeLbl"/>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.Size}"/>
                        <TextBlock Text="Date modified:" FontWeight="Bold" Margin="0,10,0,0" x:Name="PreviewDateLbl"/>
                        <TextBlock Text="{Binding ElementName=FileListView, Path=SelectedItem.DateModified}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{DynamicResource BottomBarColor}" Padding="5,0">
            <StatusBarItem x:Name="ItemCountLbl" Content="0 items" Foreground="{DynamicResource TextColor}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE14C;" ToolTip="Details View" Click="ViewDetails_Click" Foreground="{DynamicResource TextColor}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE154;" ToolTip="Large Icons View" Click="ViewLargeIcons_Click" Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
